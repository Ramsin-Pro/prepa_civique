# Copiez ce fichier en .env et adaptez les valeurs. Le fichier .env n'est jamais versionné.
# Les valeurs ci-dessous servent au développement. Celles marquées [DEV] sont interdites en production :
# l'API refuse de démarrer si elles restent en place avec une PUBLIC_URL publique (un essai sur localhost
# passe, avec un avertissement). Liste complète pour la mise en ligne : docs/exploitation.md, section 2.
# Évitez les caractères spéciaux dans le mot de passe (ils devraient être encodés dans DATABASE_URL).

# Base PostgreSQL (utilisée par docker compose)
POSTGRES_USER=prepa
# [DEV] Mot de passe d'exemple. Production : long et aléatoire, par exemple
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
POSTGRES_PASSWORD=change-moi
POSTGRES_DB=prepa_civique

# Ports ouverts sur la machine (127.0.0.1 uniquement). Ils évitent les ports habituels (5432, 4000, 3000),
# souvent déjà pris par d'autres projets.
POSTGRES_PORT=5433
API_PORT=4001
WEB_PORT=3001

# API Express, en développement local (hors Docker). [DEV] Reprend le mot de passe d'exemple.
# Dans Docker, l'adresse de la base est construite à partir des variables POSTGRES_* ci-dessus.
DATABASE_URL=postgresql://prepa:change-moi@localhost:5433/prepa_civique

# Front Next.js : adresse de l'API vue depuis le serveur Next.js
API_INTERNAL_URL=http://localhost:4001

# [DEV] Affiche aussi les questions « à relire » (brouillons non validés).
# Production : false. Rien n'est publié sans relecture humaine (cahier des charges §7).
CONTENT_PREVIEW=true

# Adresse publique du site : liens des emails, retour du paiement, contrôle d'origine des requêtes.
# Production : https://<domaine>
PUBLIC_URL=http://localhost:3001
# Cookies de connexion réservés à HTTPS. À laisser vide : ils le sont dès que PUBLIC_URL commence par https://.
COOKIE_SECURE=
# Secret de l'application : chiffrement des secrets de double authentification, empreintes des statistiques.
# Obligatoire en production et dans Docker (au moins 32 caractères aléatoires), par exemple :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=

# Emails : Mailpit en développement (docker compose up mail, boîte visible sur http://localhost:8026), Brevo en production.
# Sans SMTP_HOST, les emails sont seulement affichés dans la console de l'API (npm run dev).
# Dans Docker, l'API utilise Mailpit (service « mail ») tant que DOCKER_SMTP_HOST est vide.
# Production : DOCKER_SMTP_HOST et DOCKER_SMTP_PORT (Brevo), SMTP_USER, SMTP_PASSWORD, et MAIL_FROM sur le domaine du site.
SMTP_HOST=
SMTP_PORT=1026
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Repère <no-reply@repere.test>
DOCKER_SMTP_HOST=
DOCKER_SMTP_PORT=

# Paiement Stripe (E15). Sans clé, le développement utilise un paiement simulé ; la production refuse de vendre.
# Production : clés du mode réel ; préproduction : clés du mode test (sk_test_…).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Voix Rémy de Microsoft (Azure Speech, voix fr-FR-RemyMultilingualNeural).
# Sans clé, le site utilise la voix du navigateur (Rémy si le navigateur la propose, comme Edge).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=francecentral
SPEECH_VOICE=fr-FR-RemyMultilingualNeural

# Offre gratuite (décision n° 3)
FREE_QUESTIONS_PER_TOPIC=10
FREE_EXAMS=1
# [DEV] Désactive la double authentification du back-office. Production : à laisser vide (elle est alors obligatoire).
ADMIN_MFA_REQUIRED=false

# Comptes de l'équipe en développement, créés par npm run db:seed. Le mot de passe (DEV_ADMIN_PASSWORD)
# est généré au premier lancement et ajouté à votre .env.
DEV_ADMIN_EMAIL=admin@repere.test
DEV_EDITOR_EMAIL=relecteur@repere.test

# Page publique où laisser un avis (fiche Google, Trustpilot…). Proposée après un examen blanc réussi et dans l'email
# envoyé après la date d'examen. Vide : le site ne propose pas d'avis externe.
REVIEW_URL=

# --- Hébergement Railway (API) + Vercel (site) : docs/deploiement-railway-vercel.md ---
# Emails par API HTTP (Railway ferme les ports SMTP), prioritaires sur SMTP_HOST : Resend si sa clé est renseignée,
# sinon Brevo. MAIL_FROM doit utiliser un domaine vérifié chez ce service.
RESEND_API_KEY=
BREVO_API_KEY=
# Secret partagé entre le site et l'API (même valeur des deux côtés, 32 caractères au moins) : le site transmet
# l'adresse du visiteur, l'API ne la croit qu'avec ce secret. Vide en développement.
PROXY_SECRET=
